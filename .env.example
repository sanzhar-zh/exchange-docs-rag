# Which provider answers. Falls back to whichever key is present, so a missing
# key degrades the demo instead of stopping it.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

# Gemini free tier is capped per day and per model, and preview models are capped
# hardest. Override the default here if the quota runs out.
GEMINI_API_KEY=
GEMINI_MODEL=
